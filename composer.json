{
    "name": "innosend/magento2-order-connector",
    "description": "Innosend Order Connector Module for Magento 2 - Order synchronization",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Henk Valk",
            "email": "henk@falconmedia.nl",
            "homepage": "https://www.falconmedia.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~7.3.0||~7.4.0||~8.1.0||~8.2.0||~8.3.0",
        "magento/framework": ">=102.0.0",
        "magento/module-sales": ">=102.0.0",
        "magento/module-store": ">=101.0.0",
        "innosend/magento2-base": "^1.0.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Innosend\\OrderConnector\\": "src/"
        }
    },
    "extra": {
        "map": [
            [
                "*",
                "Innosend/OrderConnector"
            ]
        ]
    }
}



















