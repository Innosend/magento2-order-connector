<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Extended pickup point with street/zipcode/city so OrderRepositoryPlugin can set all fields -->
    <preference for="Innosend\PickupPoints\Api\Data\OrderPickupPointInterface"
                type="Innosend\OrderConnector\Model\Order\PickupPoint"/>

    <!-- OrderMapper: ShippingInformation is optional (null default) -->
    <!-- It will be injected by Innosend_PickupPoints module di.xml if that module is enabled -->
    <!-- No need to configure it here - the null default in constructor will be used -->

    <!-- Load pickup point extension attributes for REST API -->
    <!-- Dependencies (pickupPointFactory, shippingInformation) are optional and will be injected by Innosend_PickupPoints module if available -->
    <type name="Magento\Sales\Model\OrderRepository">
        <plugin name="innosend_order_connector_load_pickup_point_extension_attributes"
                type="Innosend\OrderConnector\Plugin\Sales\OrderRepositoryPlugin"
                sortOrder="10"/>
    </type>

    <!-- CLI Commands -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="innosend_test_order_mapper" xsi:type="object">Innosend\OrderConnector\Console\Command\TestOrderMapper</item>
                <item name="innosend_test_order_with_pickup_point" xsi:type="object">Innosend\OrderConnector\Console\Command\TestOrderWithPickupPoint</item>
            </argument>
        </arguments>
    </type>
</config>
